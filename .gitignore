# Python bytecode. v3 committed its __pycache__, which left orphaned .pyc files
# for modules whose source had been deleted (a0_walk_gaitgym, stage1_stand_gaitgym,
# stage2c_crutch_forward_gaitgym) and made a dead gym registration hard to spot.
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# Generated rollout data (figures are kept; they are referenced from the README)
v4/notebooks/results/

# SCONE / Hyfydy run outputs. Reference trajectories under models/reference/
# are tracked deliberately -- they are inputs, not outputs.
*.sto
*.par
!models/reference/*.sto

# The Python 3.12 environment for v5 (MyoSuite needs 3.10+; v4 is pinned to 3.9)
.venv-myo/

# MuJoCo writes this next to wherever it is run from
MUJOCO_LOG.TXT

# Project-local CPython 3.12 for v5. Copied out of uv's managed store so the
# .venv-myo interpreter does not depend on a roaming AppData path -- see
# v5/README.md. ~90 MB, regenerate rather than commit.
.python312/

# Training runs: checkpoints are ~17 MB each and logs are regenerated.
# Never delete this directory to keep it out of a commit -- ignore it.
v5/runs/
